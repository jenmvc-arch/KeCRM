# Browser-safe Supabase settings used by serve.py.
# Copy this file to .env.local and replace the values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional: select a specific organization when the user belongs to more than one.
SUPABASE_ORGANIZATION_ID=

# Never put sb_secret_*, service_role, Meta, WhatsApp, or AI secrets in a
# browser-facing variable. Server-only secrets need a separate backend worker.
